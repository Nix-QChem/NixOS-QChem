+/* Gtk3Compat.h
+ * Minimal GTK2 compatibility layer on top of GTK3, used to port Gabedit to GTK3.
+ * GdkGC and GdkPixmap are emulated with small GObjects; all drawing goes through cairo.
+ * This header is force-included (-include) in every compilation unit.
+ */
+#ifndef __GABEDIT_GTK3COMPAT_H__
+#define __GABEDIT_GTK3COMPAT_H__
+
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms-compat.h>
+#include <cairo.h>
+
+G_BEGIN_DECLS
+
+/* ---------- GtkObject ---------- */
+typedef GObject GtkObject;
+#ifndef GTK_OBJECT
+#define GTK_OBJECT(o) G_OBJECT(o)
+#define GTK_IS_OBJECT(o) G_IS_OBJECT(o)
+#endif
+#define gtk_object_destroy(o) gtk_widget_destroy(GTK_WIDGET(o))
+#define gtk_signal_connect(o, s, f, d) g_signal_connect(o, s, f, d)
+
+/* ---------- widget flags ---------- */
+enum {
+	GTK_REALIZED       = 1 << 6,
+	GTK_CAN_FOCUS      = 1 << 11,
+	GTK_CAN_DEFAULT    = 1 << 13,
+	GTK_HAS_DEFAULT    = 1 << 14
+};
+void gtk3compat_widget_set_flags(GtkWidget *w, gint flags, gboolean value);
+#define GTK_WIDGET_SET_FLAGS(w, f)   gtk3compat_widget_set_flags(GTK_WIDGET(w), (f), TRUE)
+#define GTK_WIDGET_UNSET_FLAGS(w, f) gtk3compat_widget_set_flags(GTK_WIDGET(w), (f), FALSE)
+#define GTK_WIDGET_REALIZED(w)       gtk_widget_get_realized(GTK_WIDGET(w))
+#define GTK_WIDGET_VISIBLE(w)        gtk_widget_get_visible(GTK_WIDGET(w))
+#define GTK_WIDGET_IS_SENSITIVE(w)   gtk_widget_is_sensitive(GTK_WIDGET(w))
+#define GTK_WIDGET_STATE(w)          gtk_widget_get_state(GTK_WIDGET(w))
+
+GtkAllocation gtk3compat_widget_get_allocation(GtkWidget *w);
+
+/* ---------- misc removed API ---------- */
+#define gtk_timeout_add(t, f, d)          g_timeout_add(t, f, d)
+#define gtk_timeout_remove(id)            g_source_remove(id)
+#define gtk_widget_hide_all(w)            gtk_widget_hide(w)
+#define gtk_drawing_area_size(d, w, h)    gtk_widget_set_size_request(GTK_WIDGET(d), w, h)
+#define gtk_radio_button_group(r)         gtk_radio_button_get_group(r)
+#define gtk_progress_bar_set_discrete_blocks(p, n)
+#define gtk_progress_bar_set_bar_style(p, s)
+#define gtk_about_dialog_set_url_hook(f, d, n)
+#define gdk_window_set_icon(w, i, p, m)
+#define gtk_widget_set_default_style(s)
+#define gtk_quit_add_destroy(l, o)
+#define gtk_toolbar_set_orientation(t, o) gtk_orientable_set_orientation(GTK_ORIENTABLE(t), o)
+#define gtk_combo_box_entry_new_text()    gtk_combo_box_text_new_with_entry()
+#define gtk_combo_box_append_text(c, t)   gtk_combo_box_text_append_text(GTK_COMBO_BOX_TEXT(c), t)
+#define gtk_combo_box_get_active_text(c)  gtk_combo_box_text_get_active_text(GTK_COMBO_BOX_TEXT(c))
+typedef GSourceFunc GtkFunction;
+/* GtkHandleBox (detachable bars) is replaced by a windowless GtkBin */
+GtkWidget *gtk3compat_handle_box_new(void);
+#define gtk_handle_box_new() gtk3compat_handle_box_new()
+#define gtk_handle_box_set_shadow_type(h, s)
+#define gtk_handle_box_set_handle_position(h, p)
+#define gtk_handle_box_set_snap_edge(h, e)
+#undef GTK_HANDLE_BOX
+#define GTK_HANDLE_BOX(h) (h)
+
+#define gtk3compat_color_selection(d)  gtk_color_selection_dialog_get_color_selection(GTK_COLOR_SELECTION_DIALOG(d))
+GtkWidget *gtk3compat_color_selection_dialog_button(GtkWidget *dialog, const gchar *name);
+
+/* ---------- fonts ---------- */
+typedef struct _GdkFont GdkFont;
+#define gdk_font_ref(f)   (f)
+#define gdk_font_unref(f)
+
+/* ---------- colormap ---------- */
+typedef struct _GdkColormap { gint size; GdkColor *colors; } GdkColormap;
+GdkColormap *gtk3compat_get_colormap(void);
+#define gdk_drawable_get_colormap(d) gtk3compat_get_colormap()
+#define gdk_window_get_colormap(d)   gtk3compat_get_colormap()
+#define gtk_widget_get_colormap(d)   gtk3compat_get_colormap()
+#define gdk_colormap_get_system()    gtk3compat_get_colormap()
+gboolean gdk_colormap_alloc_color(GdkColormap *c, GdkColor *color, gboolean writeable, gboolean best_match);
+void gdk_colormap_query_color(GdkColormap *c, gulong pixel, GdkColor *result);
+#define gdk_colormap_free_colors(c, colors, n)
+/* GTK3's GdkVisual is opaque: Gabedit only dereferences visuals obtained from
+ * colormaps/drawables, so those return a fake 24 bit TrueColor visual. */
+struct _GdkVisual {
+	GdkVisualType type;
+	gint depth;
+	guint32 red_mask, green_mask, blue_mask;
+	gint red_shift, green_shift, blue_shift;
+	gint red_prec, green_prec, blue_prec;
+};
+GdkVisual *gtk3compat_get_visual(void);
+#define gdk_colormap_get_visual(c) gtk3compat_get_visual()
+
+/* ---------- GC ---------- */
+typedef enum { GDK_LINE_SOLID, GDK_LINE_ON_OFF_DASH, GDK_LINE_DOUBLE_DASH } GdkLineStyle;
+typedef enum { GDK_CAP_NOT_LAST, GDK_CAP_BUTT, GDK_CAP_ROUND, GDK_CAP_PROJECTING } GdkCapStyle;
+typedef enum { GDK_JOIN_MITER, GDK_JOIN_ROUND, GDK_JOIN_BEVEL } GdkJoinStyle;
+typedef enum { GDK_SOLID, GDK_TILED, GDK_STIPPLED, GDK_OPAQUE_STIPPLED } GdkFill;
+typedef enum { GDK_COPY, GDK_INVERT, GDK_XOR } GdkFunction;
+typedef enum {
+	GDK_GC_FOREGROUND  = 1 << 0,
+	GDK_GC_BACKGROUND  = 1 << 1,
+	GDK_GC_FUNCTION    = 1 << 3,
+	GDK_GC_FILL        = 1 << 4,
+	GDK_GC_LINE_WIDTH  = 1 << 14,
+	GDK_GC_LINE_STYLE  = 1 << 15,
+	GDK_GC_CAP_STYLE   = 1 << 16,
+	GDK_GC_JOIN_STYLE  = 1 << 17
+} GdkGCValuesMask;
+
+typedef struct {
+	GdkColor foreground;
+	GdkColor background;
+	GdkFunction function;
+	GdkFill fill;
+	gint line_width;
+	GdkLineStyle line_style;
+	GdkCapStyle cap_style;
+	GdkJoinStyle join_style;
+} GdkGCValues;
+
+typedef struct _GdkGC { GObject parent; GdkGCValues v; } GdkGC;
+typedef struct _GdkGCClass { GObjectClass parent; } GdkGCClass;
+GType gdk_gc_get_type(void);
+
+GdkGC *gdk_gc_new(gpointer drawable);
+GdkGC *gdk_gc_new_with_values(gpointer drawable, GdkGCValues *values, GdkGCValuesMask mask);
+void gdk_gc_get_values(GdkGC *gc, GdkGCValues *values);
+void gdk_gc_set_values(GdkGC *gc, GdkGCValues *values, GdkGCValuesMask mask);
+void gdk_gc_set_foreground(GdkGC *gc, const GdkColor *color);
+void gdk_gc_set_background(GdkGC *gc, const GdkColor *color);
+#define gdk_gc_set_rgb_fg_color(gc, c) gdk_gc_set_foreground(gc, c)
+#define gdk_gc_set_rgb_bg_color(gc, c) gdk_gc_set_background(gc, c)
+void gdk_gc_set_line_attributes(GdkGC *gc, gint width, GdkLineStyle style, GdkCapStyle cap, GdkJoinStyle join);
+void gdk_gc_set_fill(GdkGC *gc, GdkFill fill);
+void gdk_gc_set_function(GdkGC *gc, GdkFunction f);
+#define gdk_gc_unref(gc) g_object_unref(gc)
+void gtk3compat_gc_apply(cairo_t *cr, GdkGC *gc);
+GdkGC *gtk3compat_style_gc(gint white);
+
+/* ---------- pixmaps / drawables ---------- */
+typedef struct _GdkPixmap { GObject parent; cairo_surface_t *surface; GdkPixbuf *pixbuf; gint width, height; } GdkPixmap;
+typedef struct _GdkPixmapClass { GObjectClass parent; } GdkPixmapClass;
+typedef GdkPixmap GdkBitmap;
+typedef void GdkDrawable;
+#define GDK_DRAWABLE(d) ((gpointer)(d))
+GType gdk_pixmap_get_type(void);
+#define GDK_IS_PIXMAP(o) G_TYPE_CHECK_INSTANCE_TYPE((o), gdk_pixmap_get_type())
+#define GDK_IS_DRAWABLE(o) (GDK_IS_WINDOW(o) || GDK_IS_PIXMAP(o))
+
+GdkPixmap *gdk_pixmap_new(gpointer drawable, gint width, gint height, gint depth);
+GdkPixmap *gdk_pixmap_create_from_xpm_d(gpointer drawable, GdkBitmap **mask, const GdkColor *bg, gchar **data);
+#define gdk_pixmap_unref(p) g_object_unref(p)
+#define gdk_bitmap_unref(p) g_object_unref(p)
+GtkWidget *gtk_image_new_from_pixmap(GdkPixmap *pixmap, GdkBitmap *mask);
+void gdk_drawable_get_size(gpointer drawable, gint *width, gint *height);
+#define gdk_drawable_get_depth(d) 24
+#define gdk_drawable_get_visual(d) gtk3compat_get_visual()
+
+cairo_t *gtk3compat_cairo_create(gpointer drawable);
+#define gdk_cairo_create(d) gtk3compat_cairo_create((gpointer)(d))
+void gtk3compat_cairo_set_source_drawable(cairo_t *cr, gpointer drawable, gdouble x, gdouble y);
+#define gdk_cairo_set_source_pixmap(cr, p, x, y) gtk3compat_cairo_set_source_drawable(cr, p, x, y)
+void gtk3compat_queue_draw(gpointer drawable);
+gulong gtk3compat_connect_expose(gpointer instance, GCallback cb, gpointer data);
+gboolean gtk3compat_draw_as_expose(GtkWidget *widget, cairo_t *cr, GCallback cb, gpointer data);
+cairo_t *gtk3compat_current_draw_cr(gpointer window);
+void gtk3compat_paint_layout(GtkStyle *style, gpointer window, GtkStateType state, gboolean use_text, const GdkRectangle *area, GtkWidget *widget, const gchar *detail, gint x, gint y, PangoLayout *layout);
+void gtk3compat_paint_flat_box(GtkStyle *style, gpointer window, GtkStateType state, GtkShadowType shadow, const GdkRectangle *area, GtkWidget *widget, const gchar *detail, gint x, gint y, gint width, gint height);
+#define gtk_paint_layout gtk3compat_paint_layout
+#define gtk_paint_flat_box gtk3compat_paint_flat_box
+
+void gdk_draw_line(gpointer d, GdkGC *gc, gint x1, gint y1, gint x2, gint y2);
+void gdk_draw_rectangle(gpointer d, GdkGC *gc, gboolean filled, gint x, gint y, gint w, gint h);
+void gdk_draw_arc(gpointer d, GdkGC *gc, gboolean filled, gint x, gint y, gint w, gint h, gint a1, gint a2);
+void gdk_draw_polygon(gpointer d, GdkGC *gc, gboolean filled, const GdkPoint *points, gint n);
+void gdk_draw_drawable(gpointer d, GdkGC *gc, gpointer src, gint xs, gint ys, gint xd, gint yd, gint w, gint h);
+void gdk_draw_layout(gpointer d, GdkGC *gc, gint x, gint y, PangoLayout *layout);
+void gdk_draw_point(gpointer d, GdkGC *gc, gint x, gint y);
+GdkPixbuf *gdk_pixbuf_get_from_drawable(GdkPixbuf *dest, gpointer src, gpointer cmap, gint sx, gint sy, gint dx, gint dy, gint w, gint h);
+
+/* GdkImage: pixel read-back, pixels are 0xRRGGBB */
+typedef struct _GdkImage { GdkPixbuf *pixbuf; } GdkImage;
+GdkImage *gdk_drawable_get_image(gpointer d, gint x, gint y, gint w, gint h);
+#define gdk_image_get(d, x, y, w, h) gdk_drawable_get_image(d, x, y, w, h)
+guint32 gdk_image_get_pixel(GdkImage *image, gint x, gint y);
+void gdk_image_destroy(GdkImage *image);
+#define gdk_image_unref(i) gdk_image_destroy(i)
+
+G_END_DECLS
+
+#endif /* __GABEDIT_GTK3COMPAT_H__ */
diff --git a/src/Common/GtkGLCompat.c b/src/Common/GtkGLCompat.c
new file mode 100644
index 0000000..b38c2f6
--- /dev/null
+++ b/src/Common/GtkGLCompat.c
@@ -0,0 +1,161 @@
+/* GtkGLCompat.c
+ * Replacement for the subset of GtkGLExt used by Gabedit, see GtkGLCompat.h
+ */
+#include "GtkGLCompat.h"
+#include <gdk/gdkx.h>
+#include <GL/glx.h>
+
+struct _GabeditGLConfig {
+	GdkGLConfigMode mode;
+	XVisualInfo *vi;
+};
+
+struct _GabeditGLContext {
+	GLXContext ctx;
+	GabeditGLConfig *config;
+};
+
+static Display *get_xdisplay(void)
+{
+	GdkDisplay *display = gdk_display_get_default();
+	if(!display || !GDK_IS_X11_DISPLAY(display)) return NULL;
+	return GDK_DISPLAY_XDISPLAY(display);
+}
+
+GabeditGLConfig *gabedit_gl_config_new_by_mode(GdkGLConfigMode mode)
+{
+	int attribs[32];
+	int k = 0;
+	XVisualInfo *vi;
+	GabeditGLConfig *config;
+	Display *dpy = get_xdisplay();
+
+	if(!dpy)
+	{
+		g_warning("Gabedit: OpenGL requires the X11 backend (GDK_BACKEND=x11)");
+		return NULL;
+	}
+	attribs[k++] = GLX_RGBA;
+	attribs[k++] = GLX_RED_SIZE; attribs[k++] = 1;
+	attribs[k++] = GLX_GREEN_SIZE; attribs[k++] = 1;
+	attribs[k++] = GLX_BLUE_SIZE; attribs[k++] = 1;
+	if(mode & GDK_GL_MODE_DOUBLE) attribs[k++] = GLX_DOUBLEBUFFER;
+	if(mode & GDK_GL_MODE_ALPHA) { attribs[k++] = GLX_ALPHA_SIZE; attribs[k++] = 1; }
+	if(mode & GDK_GL_MODE_DEPTH) { attribs[k++] = GLX_DEPTH_SIZE; attribs[k++] = 1; }
+	if(mode & GDK_GL_MODE_STENCIL) { attribs[k++] = GLX_STENCIL_SIZE; attribs[k++] = 1; }
+	if(mode & GDK_GL_MODE_ACCUM)
+	{
+		attribs[k++] = GLX_ACCUM_RED_SIZE; attribs[k++] = 1;
+		attribs[k++] = GLX_ACCUM_GREEN_SIZE; attribs[k++] = 1;
+		attribs[k++] = GLX_ACCUM_BLUE_SIZE; attribs[k++] = 1;
+	}
+	attribs[k++] = None;
+
+	vi = glXChooseVisual(dpy, DefaultScreen(dpy), attribs);
+	if(!vi) return NULL;
+	config = g_new0(GabeditGLConfig, 1);
+	config->mode = mode;
+	config->vi = vi;
+	return config;
+}
+
+static void gl_realize(GtkWidget *widget, gpointer data)
+{
+	GabeditGLConfig *config = g_object_get_data(G_OBJECT(widget), "GabeditGLConfig");
+	GabeditGLContext *context;
+	Display *dpy = get_xdisplay();
+	GdkWindow *window = gtk_widget_get_window(widget);
+
+	if(!config || !dpy || !window) return;
+	if(!gdk_window_ensure_native(window))
+	{
+		g_warning("Gabedit: cannot create a native window for OpenGL");
+		return;
+	}
+	context = g_new0(GabeditGLContext, 1);
+	context->config = config;
+	context->ctx = glXCreateContext(dpy, config->vi, NULL, (Bool)GPOINTER_TO_INT(data));
+	if(!context->ctx)
+	{
+		g_warning("Gabedit: cannot create the OpenGL context");
+		g_free(context);
+		return;
+	}
+	g_object_set_data(G_OBJECT(widget), "GabeditGLContext", context);
+}
+
+static void gl_unrealize(GtkWidget *widget, gpointer data)
+{
+	GabeditGLContext *context = g_object_get_data(G_OBJECT(widget), "GabeditGLContext");
+	Display *dpy = get_xdisplay();
+	if(!context) return;
+	if(dpy)
+	{
+		if(glXGetCurrentContext() == context->ctx) glXMakeCurrent(dpy, None, NULL);
+		glXDestroyContext(dpy, context->ctx);
+	}
+	g_object_set_data(G_OBJECT(widget), "GabeditGLContext", NULL);
+	g_free(context);
+}
+
+gboolean gtk_widget_set_gl_capability(GtkWidget *widget, GabeditGLConfig *config, GabeditGLContext *share, gboolean direct, int render_type)
+{
+	GdkVisual *visual;
+	if(!widget || !config) return FALSE;
+	visual = gdk_x11_screen_lookup_visual(gtk_widget_get_screen(widget), config->vi->visualid);
+	if(visual) gtk_widget_set_visual(widget, visual);
+	G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+	gtk_widget_set_double_buffered(widget, FALSE);
+	G_GNUC_END_IGNORE_DEPRECATIONS
+	gtk_widget_set_app_paintable(widget, TRUE);
+	g_object_set_data(G_OBJECT(widget), "GabeditGLConfig", config);
+	/* connected before the callbacks of Gabedit: the context exists when they run */
+	g_signal_connect(G_OBJECT(widget), "realize", G_CALLBACK(gl_realize), GINT_TO_POINTER(direct));
+	g_signal_connect(G_OBJECT(widget), "unrealize", G_CALLBACK(gl_unrealize), NULL);
+	return TRUE;
+}
+
+GabeditGLContext *gabedit_widget_get_gl_context(GtkWidget *widget)
+{
+	if(!widget || !G_IS_OBJECT(widget)) return NULL;
+	return g_object_get_data(G_OBJECT(widget), "GabeditGLContext");
+}
+
+gboolean gdk_gl_drawable_gl_begin(GdkGLDrawable *drawable, GabeditGLContext *context)
+{
+	Display *dpy = get_xdisplay();
+	GdkWindow *window;
+	if(!dpy || !context || !drawable || !GTK_IS_WIDGET(drawable)) return FALSE;
+	window = gtk_widget_get_window(GTK_WIDGET(drawable));
+	if(!window) return FALSE;
+	return glXMakeCurrent(dpy, GDK_WINDOW_XID(window), context->ctx);
+}
+
+void gdk_gl_drawable_gl_end(GdkGLDrawable *drawable)
+{
+}
+
+gboolean gdk_gl_drawable_is_double_buffered(GdkGLDrawable *drawable)
+{
+	GabeditGLContext *context = gabedit_widget_get_gl_context(GTK_WIDGET(drawable));
+	return context && (context->config->mode & GDK_GL_MODE_DOUBLE);
+}
+
+void gdk_gl_drawable_swap_buffers(GdkGLDrawable *drawable)
+{
+	Display *dpy = get_xdisplay();
+	GdkWindow *window;
+	if(!dpy || !drawable) return;
+	window = gtk_widget_get_window(GTK_WIDGET(drawable));
+	if(window) glXSwapBuffers(dpy, GDK_WINDOW_XID(window));
+}
+
+gchar *gdk_gl_get_info(void)
+{
+	Display *dpy = get_xdisplay();
+	if(!dpy) return g_strdup("No X11 display");
+	return g_strdup_printf("OpenGL extension version - %d.%d\nGLX vendor: %s\nGLX version: %s\n",
+		1, 4,
+		glXQueryServerString(dpy, DefaultScreen(dpy), GLX_VENDOR),
+		glXQueryServerString(dpy, DefaultScreen(dpy), GLX_VERSION));
+}
diff --git a/src/Common/GtkGLCompat.h b/src/Common/GtkGLCompat.h
new file mode 100644
index 0000000..2cbb0b3
--- /dev/null
+++ b/src/Common/GtkGLCompat.h
@@ -0,0 +1,48 @@
+/* GtkGLCompat.h
+ * Replacement for the subset of GtkGLExt used by Gabedit.
+ * An OpenGL (GLX, compatibility profile) context is bound to the native
+ * X11 window of a GtkDrawingArea. Requires the X11 GDK backend.
+ */
+#ifndef __GABEDIT_GTKGLCOMPAT_H__
+#define __GABEDIT_GTKGLCOMPAT_H__
+
+#include <gtk/gtk.h>
+#include <GL/gl.h>
+
+typedef enum {
+	GDK_GL_MODE_RGB     = 0,
+	GDK_GL_MODE_RGBA    = 0,
+	GDK_GL_MODE_SINGLE  = 0,
+	GDK_GL_MODE_DOUBLE  = 1 << 1,
+	GDK_GL_MODE_ACCUM   = 1 << 2,
+	GDK_GL_MODE_ALPHA   = 1 << 3,
+	GDK_GL_MODE_DEPTH   = 1 << 4,
+	GDK_GL_MODE_STENCIL = 1 << 5
+} GdkGLConfigMode;
+
+#define GDK_GL_RGBA_TYPE   0x8014
+#define GDK_GL_DOUBLEBUFFER 5
+#define GDK_GL_ALPHA_SIZE  11
+#define GDK_GL_DEPTH_SIZE  12
+
+/* GTK3 has its own GdkGLContext, rename the GtkGLExt types */
+typedef struct _GabeditGLConfig GabeditGLConfig;
+typedef struct _GabeditGLContext GabeditGLContext;
+#define GdkGLConfig GabeditGLConfig
+#define GdkGLContext GabeditGLContext
+typedef GtkWidget GdkGLDrawable;
+
+#define gtk_gl_init(argc, argv)
+GabeditGLConfig *gabedit_gl_config_new_by_mode(GdkGLConfigMode mode);
+#define gdk_gl_config_new_by_mode(m) gabedit_gl_config_new_by_mode(m)
+gboolean gtk_widget_set_gl_capability(GtkWidget *widget, GabeditGLConfig *config, GabeditGLContext *share, gboolean direct, int render_type);
+GabeditGLContext *gabedit_widget_get_gl_context(GtkWidget *widget);
+#define gtk_widget_get_gl_context(w) gabedit_widget_get_gl_context(w)
+#define gtk_widget_get_gl_drawable(w) ((GdkGLDrawable*)(w))
+gboolean gdk_gl_drawable_gl_begin(GdkGLDrawable *drawable, GabeditGLContext *context);
+void gdk_gl_drawable_gl_end(GdkGLDrawable *drawable);
+gboolean gdk_gl_drawable_is_double_buffered(GdkGLDrawable *drawable);
+void gdk_gl_drawable_swap_buffers(GdkGLDrawable *drawable);
+gchar *gdk_gl_get_info(void);
+
+#endif /* __GABEDIT_GTKGLCOMPAT_H__ */
