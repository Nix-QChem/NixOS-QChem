diff --git a/src/Common/Gtk3Compat.c b/src/Common/Gtk3Compat.c
new file mode 100644
index 0000000..0441bd4
--- /dev/null
+++ b/src/Common/Gtk3Compat.c
@@ -0,0 +1,500 @@
+/* Gtk3Compat.c
+ * Implementation of the small GTK2 compatibility layer, see Gtk3Compat.h
+ */
+#include "Gtk3Compat.h"
+#include <math.h>
+#include <string.h>
+
+/* the real GTK3 function, overridden by a macro in Gtk3Compat.h */
+#undef gdk_cairo_create
+
+/* ---------- widgets ---------- */
+void gtk3compat_widget_set_flags(GtkWidget *w, gint flags, gboolean value)
+{
+	if(!w) return;
+	if(flags & GTK_CAN_DEFAULT) gtk_widget_set_can_default(w, value);
+	if(flags & GTK_CAN_FOCUS) gtk_widget_set_can_focus(w, value);
+	if(flags & GTK_REALIZED) gtk_widget_set_realized(w, value);
+	if((flags & GTK_HAS_DEFAULT) && value) gtk_widget_grab_default(w);
+}
+
+GtkAllocation gtk3compat_widget_get_allocation(GtkWidget *w)
+{
+	GtkAllocation a = {0, 0, 1, 1};
+	if(w) gtk_widget_get_allocation(w, &a);
+	return a;
+}
+
+GtkWidget *gtk3compat_color_selection_dialog_button(GtkWidget *dialog, const gchar *name)
+{
+	GtkWidget *b = NULL;
+	g_object_get(G_OBJECT(dialog), name, &b, NULL);
+	if(b) g_object_unref(b);
+	return b;
+}
+
+/* ---------- colormap: pixel values are plain 0xRRGGBB ---------- */
+static GdkColormap theColormap = { 0, NULL };
+static GdkVisual theVisual = { GDK_VISUAL_TRUE_COLOR, 24, 0xff0000, 0x00ff00, 0x0000ff, 16, 8, 0, 8, 8, 8 };
+GdkVisual *gtk3compat_get_visual(void) { return &theVisual; }
+GdkColormap *gtk3compat_get_colormap(void) { return &theColormap; }
+
+gboolean gdk_colormap_alloc_color(GdkColormap *c, GdkColor *color, gboolean writeable, gboolean best_match)
+{
+	if(!color) return FALSE;
+	color->pixel = ((color->red >> 8) << 16) | ((color->green >> 8) << 8) | (color->blue >> 8);
+	return TRUE;
+}
+
+void gdk_colormap_query_color(GdkColormap *c, gulong pixel, GdkColor *result)
+{
+	if(!result) return;
+	result->pixel = pixel;
+	result->red = ((pixel >> 16) & 0xff) * 257;
+	result->green = ((pixel >> 8) & 0xff) * 257;
+	result->blue = (pixel & 0xff) * 257;
+}
+
+/* ---------- GC ---------- */
+G_DEFINE_TYPE(GdkGC, gdk_gc, G_TYPE_OBJECT)
+static void gdk_gc_class_init(GdkGCClass *klass) { }
+static void gdk_gc_init(GdkGC *gc)
+{
+	gc->v.line_width = 0;
+	gc->v.line_style = GDK_LINE_SOLID;
+	gc->v.cap_style = GDK_CAP_BUTT;
+	gc->v.join_style = GDK_JOIN_MITER;
+	gc->v.fill = GDK_SOLID;
+	gc->v.function = GDK_COPY;
+	gc->v.background.red = gc->v.background.green = gc->v.background.blue = 65535;
+	gdk_colormap_alloc_color(NULL, &gc->v.background, FALSE, TRUE);
+}
+
+GdkGC *gdk_gc_new(gpointer drawable) { return g_object_new(gdk_gc_get_type(), NULL); }
+
+GdkGC *gdk_gc_new_with_values(gpointer drawable, GdkGCValues *values, GdkGCValuesMask mask)
+{
+	GdkGC *gc = gdk_gc_new(drawable);
+	gdk_gc_set_values(gc, values, mask);
+	return gc;
+}
+
+void gdk_gc_set_values(GdkGC *gc, GdkGCValues *values, GdkGCValuesMask mask)
+{
+	if(!gc || !values) return;
+	if(mask & GDK_GC_FOREGROUND) gc->v.foreground = values->foreground;
+	if(mask & GDK_GC_BACKGROUND) gc->v.background = values->background;
+	if(mask & GDK_GC_FUNCTION) gc->v.function = values->function;
+	if(mask & GDK_GC_FILL) gc->v.fill = values->fill;
+	if(mask & GDK_GC_LINE_WIDTH) gc->v.line_width = values->line_width;
+	if(mask & GDK_GC_LINE_STYLE) gc->v.line_style = values->line_style;
+	if(mask & GDK_GC_CAP_STYLE) gc->v.cap_style = values->cap_style;
+	if(mask & GDK_GC_JOIN_STYLE) gc->v.join_style = values->join_style;
+}
+
+void gdk_gc_get_values(GdkGC *gc, GdkGCValues *values)
+{
+	if(gc && values) *values = gc->v;
+}
+
+void gdk_gc_set_foreground(GdkGC *gc, const GdkColor *color)
+{
+	if(!gc || !color) return;
+	gc->v.foreground = *color;
+	gdk_colormap_alloc_color(NULL, &gc->v.foreground, FALSE, TRUE);
+}
+
+void gdk_gc_set_background(GdkGC *gc, const GdkColor *color)
+{
+	if(!gc || !color) return;
+	gc->v.background = *color;
+	gdk_colormap_alloc_color(NULL, &gc->v.background, FALSE, TRUE);
+}
+
+void gdk_gc_set_line_attributes(GdkGC *gc, gint width, GdkLineStyle style, GdkCapStyle cap, GdkJoinStyle join)
+{
+	if(!gc) return;
+	gc->v.line_width = width;
+	gc->v.line_style = style;
+	gc->v.cap_style = cap;
+	gc->v.join_style = join;
+}
+
+void gdk_gc_set_fill(GdkGC *gc, GdkFill fill) { if(gc) gc->v.fill = fill; }
+void gdk_gc_set_function(GdkGC *gc, GdkFunction f) { if(gc) gc->v.function = f; }
+
+void gtk3compat_gc_apply(cairo_t *cr, GdkGC *gc)
+{
+	gdouble w;
+	if(!gc) return;
+	gdk_cairo_set_source_color(cr, &gc->v.foreground);
+	w = gc->v.line_width > 0 ? gc->v.line_width : 1;
+	cairo_set_line_width(cr, w);
+	switch(gc->v.cap_style)
+	{
+		case GDK_CAP_ROUND: cairo_set_line_cap(cr, CAIRO_LINE_CAP_ROUND); break;
+		case GDK_CAP_PROJECTING: cairo_set_line_cap(cr, CAIRO_LINE_CAP_SQUARE); break;
+		default: cairo_set_line_cap(cr, CAIRO_LINE_CAP_BUTT);
+	}
+	switch(gc->v.join_style)
+	{
+		case GDK_JOIN_ROUND: cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND); break;
+		case GDK_JOIN_BEVEL: cairo_set_line_join(cr, CAIRO_LINE_JOIN_BEVEL); break;
+		default: cairo_set_line_join(cr, CAIRO_LINE_JOIN_MITER);
+	}
+	if(gc->v.line_style != GDK_LINE_SOLID)
+	{
+		gdouble dash = 4.0*w;
+		cairo_set_dash(cr, &dash, 1, 0);
+	}
+	else cairo_set_dash(cr, NULL, 0, 0);
+	if(gc->v.function == GDK_XOR || gc->v.function == GDK_INVERT)
+		cairo_set_operator(cr, CAIRO_OPERATOR_DIFFERENCE);
+}
+
+/* ---------- pixmaps ---------- */
+G_DEFINE_TYPE(GdkPixmap, gdk_pixmap, G_TYPE_OBJECT)
+static void gdk_pixmap_finalize(GObject *o)
+{
+	GdkPixmap *p = (GdkPixmap*)o;
+	if(p->surface) cairo_surface_destroy(p->surface);
+	if(p->pixbuf) g_object_unref(p->pixbuf);
+	G_OBJECT_CLASS(gdk_pixmap_parent_class)->finalize(o);
+}
+static void gdk_pixmap_class_init(GdkPixmapClass *klass) { G_OBJECT_CLASS(klass)->finalize = gdk_pixmap_finalize; }
+static void gdk_pixmap_init(GdkPixmap *p) { }
+
+GdkPixmap *gdk_pixmap_new(gpointer drawable, gint width, gint height, gint depth)
+{
+	GdkPixmap *p = g_object_new(gdk_pixmap_get_type(), NULL);
+	if(width < 1) width = 1;
+	if(height < 1) height = 1;
+	p->width = width;
+	p->height = height;
+	p->surface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, width, height);
+	return p;
+}
+
+GdkPixmap *gdk_pixmap_create_from_xpm_d(gpointer drawable, GdkBitmap **mask, const GdkColor *bg, gchar **data)
+{
+	GdkPixbuf *pixbuf = gdk_pixbuf_new_from_xpm_data((const char**)data);
+	GdkPixmap *p;
+	cairo_t *cr;
+	if(mask) *mask = NULL;
+	if(!pixbuf) return NULL;
+	p = g_object_new(gdk_pixmap_get_type(), NULL);
+	p->pixbuf = pixbuf;
+	p->width = gdk_pixbuf_get_width(pixbuf);
+	p->height = gdk_pixbuf_get_height(pixbuf);
+	p->surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, p->width, p->height);
+	cr = cairo_create(p->surface);
+	gdk_cairo_set_source_pixbuf(cr, pixbuf, 0, 0);
+	cairo_paint(cr);
+	cairo_destroy(cr);
+	return p;
+}
+
+GtkWidget *gtk_image_new_from_pixmap(GdkPixmap *pixmap, GdkBitmap *mask)
+{
+	GdkPixbuf *pixbuf;
+	GtkWidget *image;
+	if(!pixmap) return gtk_image_new();
+	if(pixmap->pixbuf) return gtk_image_new_from_pixbuf(pixmap->pixbuf);
+	cairo_surface_flush(pixmap->surface);
+	pixbuf = gdk_pixbuf_get_from_surface(pixmap->surface, 0, 0, pixmap->width, pixmap->height);
+	image = gtk_image_new_from_pixbuf(pixbuf);
+	if(pixbuf) g_object_unref(pixbuf);
+	return image;
+}
+
+void gdk_drawable_get_size(gpointer drawable, gint *width, gint *height)
+{
+	gint w = 0, h = 0;
+	if(drawable && GDK_IS_PIXMAP(drawable)) { w = ((GdkPixmap*)drawable)->width; h = ((GdkPixmap*)drawable)->height; }
+	else if(drawable && GDK_IS_WINDOW(drawable)) { w = gdk_window_get_width(drawable); h = gdk_window_get_height(drawable); }
+	if(width) *width = w;
+	if(height) *height = h;
+}
+
+/* drawing directly on a window is only possible outside the draw signal on X11;
+ * it is used by Gabedit for transient feedback (rubber band, etc) */
+cairo_t *gtk3compat_cairo_create(gpointer drawable)
+{
+	if(drawable && GDK_IS_PIXMAP(drawable)) return cairo_create(((GdkPixmap*)drawable)->surface);
+	if(drawable && GDK_IS_WINDOW(drawable))
+	{
+		cairo_t *cr = gtk3compat_current_draw_cr(drawable);
+		if(cr) return cr;
+		G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+		return gdk_cairo_create(GDK_WINDOW(drawable));
+		G_GNUC_END_IGNORE_DEPRECATIONS
+	}
+	/* never return NULL, cairo calls on a dummy surface are harmless */
+	{
+		cairo_surface_t *s = cairo_image_surface_create(CAIRO_FORMAT_RGB24, 1, 1);
+		cairo_t *cr = cairo_create(s);
+		cairo_surface_destroy(s);
+		return cr;
+	}
+}
+
+void gtk3compat_cairo_set_source_drawable(cairo_t *cr, gpointer drawable, gdouble x, gdouble y)
+{
+	if(drawable && GDK_IS_PIXMAP(drawable)) cairo_set_source_surface(cr, ((GdkPixmap*)drawable)->surface, x, y);
+	else if(drawable && GDK_IS_WINDOW(drawable)) gdk_cairo_set_source_window(cr, GDK_WINDOW(drawable), x, y);
+}
+
+static void finish(cairo_t *cr, GdkGC *gc, gboolean filled)
+{
+	if(filled) cairo_fill(cr);
+	else cairo_stroke(cr);
+	cairo_destroy(cr);
+}
+
+void gdk_draw_line(gpointer d, GdkGC *gc, gint x1, gint y1, gint x2, gint y2)
+{
+	cairo_t *cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	cairo_move_to(cr, x1 + 0.5, y1 + 0.5);
+	cairo_line_to(cr, x2 + 0.5, y2 + 0.5);
+	finish(cr, gc, FALSE);
+}
+
+void gdk_draw_point(gpointer d, GdkGC *gc, gint x, gint y)
+{
+	cairo_t *cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	cairo_rectangle(cr, x, y, 1, 1);
+	finish(cr, gc, TRUE);
+}
+
+void gdk_draw_rectangle(gpointer d, GdkGC *gc, gboolean filled, gint x, gint y, gint w, gint h)
+{
+	cairo_t *cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	if(filled) cairo_rectangle(cr, x, y, w, h);
+	else cairo_rectangle(cr, x + 0.5, y + 0.5, w, h);
+	finish(cr, gc, filled);
+}
+
+void gdk_draw_arc(gpointer d, GdkGC *gc, gboolean filled, gint x, gint y, gint w, gint h, gint a1, gint a2)
+{
+	cairo_t *cr;
+	gdouble start = -a1/64.0*G_PI/180.0;
+	gdouble end = -(a1 + a2)/64.0*G_PI/180.0;
+	if(w <= 0 || h <= 0) return;
+	cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	cairo_save(cr);
+	cairo_translate(cr, x + w/2.0, y + h/2.0);
+	cairo_scale(cr, w/2.0, h/2.0);
+	if(filled) cairo_move_to(cr, 0, 0);
+	if(a2 >= 0) cairo_arc_negative(cr, 0, 0, 1.0, start, end);
+	else cairo_arc(cr, 0, 0, 1.0, start, end);
+	if(filled) cairo_close_path(cr);
+	cairo_restore(cr);
+	finish(cr, gc, filled);
+}
+
+void gdk_draw_polygon(gpointer d, GdkGC *gc, gboolean filled, const GdkPoint *points, gint n)
+{
+	cairo_t *cr;
+	gint i;
+	if(n < 1) return;
+	cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	cairo_move_to(cr, points[0].x + 0.5, points[0].y + 0.5);
+	for(i = 1; i < n; i++) cairo_line_to(cr, points[i].x + 0.5, points[i].y + 0.5);
+	cairo_close_path(cr);
+	finish(cr, gc, filled);
+}
+
+void gdk_draw_drawable(gpointer d, GdkGC *gc, gpointer src, gint xs, gint ys, gint xd, gint yd, gint w, gint h)
+{
+	cairo_t *cr = gtk3compat_cairo_create(d);
+	if(w < 0) { gint ww; gdk_drawable_get_size(src, &ww, NULL); w = ww - xs; }
+	if(h < 0) { gint hh; gdk_drawable_get_size(src, NULL, &hh); h = hh - ys; }
+	gtk3compat_cairo_set_source_drawable(cr, src, xd - xs, yd - ys);
+	cairo_rectangle(cr, xd, yd, w, h);
+	cairo_fill(cr);
+	cairo_destroy(cr);
+}
+
+void gdk_draw_layout(gpointer d, GdkGC *gc, gint x, gint y, PangoLayout *layout)
+{
+	cairo_t *cr = gtk3compat_cairo_create(d);
+	gtk3compat_gc_apply(cr, gc);
+	cairo_move_to(cr, x, y);
+	pango_cairo_show_layout(cr, layout);
+	cairo_destroy(cr);
+}
+
+/* if a window is passed, ask GTK to repaint the widget owning it */
+void gtk3compat_queue_draw(gpointer drawable)
+{
+	gpointer widget = NULL;
+	if(drawable && GDK_IS_WINDOW(drawable))
+	{
+		gdk_window_get_user_data(GDK_WINDOW(drawable), &widget);
+		if(widget && GTK_IS_WIDGET(widget)) gtk_widget_queue_draw(GTK_WIDGET(widget));
+	}
+}
+
+GdkPixbuf *gdk_pixbuf_get_from_drawable(GdkPixbuf *dest, gpointer src, gpointer cmap, gint sx, gint sy, gint dx, gint dy, gint w, gint h)
+{
+	GdkPixbuf *pixbuf = NULL;
+	if(src && GDK_IS_PIXMAP(src))
+	{
+		GdkPixmap *p = (GdkPixmap*)src;
+		cairo_surface_flush(p->surface);
+		pixbuf = gdk_pixbuf_get_from_surface(p->surface, sx, sy, w, h);
+	}
+	else if(src && GDK_IS_WINDOW(src)) pixbuf = gdk_pixbuf_get_from_window(GDK_WINDOW(src), sx, sy, w, h);
+	if(!pixbuf) return NULL;
+	if(dest)
+	{
+		gdk_pixbuf_copy_area(pixbuf, 0, 0, w, h, dest, dx, dy);
+		g_object_unref(pixbuf);
+		return dest;
+	}
+	return pixbuf;
+}
+
+GdkImage *gdk_drawable_get_image(gpointer d, gint x, gint y, gint w, gint h)
+{
+	GdkImage *image;
+	GdkPixbuf *pixbuf = gdk_pixbuf_get_from_drawable(NULL, d, NULL, x, y, 0, 0, w, h);
+	if(!pixbuf) return NULL;
+	image = g_new0(GdkImage, 1);
+	image->pixbuf = pixbuf;
+	return image;
+}
+
+guint32 gdk_image_get_pixel(GdkImage *image, gint x, gint y)
+{
+	guchar *p;
+	if(!image || !image->pixbuf) return 0;
+	if(x < 0 || y < 0 || x >= gdk_pixbuf_get_width(image->pixbuf) || y >= gdk_pixbuf_get_height(image->pixbuf)) return 0;
+	p = gdk_pixbuf_get_pixels(image->pixbuf) + y*gdk_pixbuf_get_rowstride(image->pixbuf) + x*gdk_pixbuf_get_n_channels(image->pixbuf);
+	return (p[0] << 16) | (p[1] << 8) | p[2];
+}
+
+void gdk_image_destroy(GdkImage *image)
+{
+	if(!image) return;
+	if(image->pixbuf) g_object_unref(image->pixbuf);
+	g_free(image);
+}
+
+/* replacement for GtkStyle black_gc (0), white_gc (1) and fg_gc */
+GdkGC *gtk3compat_style_gc(gint white)
+{
+	static GdkGC *gcs[2] = {NULL, NULL};
+	white = white ? 1 : 0;
+	if(!gcs[white])
+	{
+		GdkColor c;
+		c.red = c.green = c.blue = white ? 65535 : 0;
+		gcs[white] = gdk_gc_new(NULL);
+		gdk_gc_set_foreground(gcs[white], &c);
+	}
+	return gcs[white];
+}
+
+/* GTK2 "expose_event" handlers run from the GTK3 "draw" signal.
+ * While a handler runs, gdk_cairo_create() on the widget's window
+ * returns the cairo context given by the draw signal. */
+typedef gboolean (*ExposeFunc)(GtkWidget*, GdkEventExpose*, gpointer);
+typedef struct { GCallback cb; gpointer data; } ExposeClosure;
+static GdkWindow *currentDrawWindow = NULL;
+static cairo_t *currentDrawCr = NULL;
+
+gboolean gtk3compat_draw_as_expose(GtkWidget *widget, cairo_t *cr, GCallback cb, gpointer data)
+{
+	GdkEventExpose ev;
+	GdkRectangle r;
+	GdkWindow *oldWindow = currentDrawWindow;
+	cairo_t *oldCr = currentDrawCr;
+	gboolean result;
+
+	if(!gdk_cairo_get_clip_rectangle(cr, &r))
+	{
+		r.x = r.y = 0;
+		r.width = gtk_widget_get_allocated_width(widget);
+		r.height = gtk_widget_get_allocated_height(widget);
+	}
+	memset(&ev, 0, sizeof(ev));
+	ev.type = GDK_EXPOSE;
+	ev.window = gtk_widget_get_window(widget);
+	ev.send_event = FALSE;
+	ev.area = r;
+	ev.region = cairo_region_create_rectangle(&r);
+	ev.count = 0;
+
+	currentDrawWindow = ev.window;
+	currentDrawCr = cr;
+	cairo_save(cr);
+	result = ((ExposeFunc)cb)(widget, &ev, data);
+	cairo_restore(cr);
+	currentDrawWindow = oldWindow;
+	currentDrawCr = oldCr;
+	cairo_region_destroy(ev.region);
+	return result;
+}
+
+static gboolean expose_trampoline(GtkWidget *widget, cairo_t *cr, ExposeClosure *c)
+{
+	return gtk3compat_draw_as_expose(widget, cr, c->cb, c->data);
+}
+
+static void expose_closure_free(gpointer data, GClosure *closure) { g_free(data); }
+
+gulong gtk3compat_connect_expose(gpointer instance, GCallback cb, gpointer data)
+{
+	ExposeClosure *c = g_new0(ExposeClosure, 1);
+	c->cb = cb;
+	c->data = data;
+	return g_signal_connect_data(instance, "draw", G_CALLBACK(expose_trampoline), c, expose_closure_free, 0);
+}
+
+cairo_t *gtk3compat_current_draw_cr(gpointer window)
+{
+	if(currentDrawCr && window == (gpointer)currentDrawWindow) return cairo_reference(currentDrawCr);
+	return NULL;
+}
+
+#undef gtk_paint_layout
+#undef gtk_paint_flat_box
+void gtk3compat_paint_layout(GtkStyle *style, gpointer window, GtkStateType state, gboolean use_text,
+		const GdkRectangle *area, GtkWidget *widget, const gchar *detail, gint x, gint y, PangoLayout *layout)
+{
+	cairo_t *cr = gtk3compat_cairo_create(window);
+	if(area) { gdk_cairo_rectangle(cr, area); cairo_clip(cr); }
+	G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+	gtk_paint_layout(style, cr, state, use_text, widget, detail, x, y, layout);
+	G_GNUC_END_IGNORE_DEPRECATIONS
+	cairo_destroy(cr);
+}
+
+void gtk3compat_paint_flat_box(GtkStyle *style, gpointer window, GtkStateType state, GtkShadowType shadow,
+		const GdkRectangle *area, GtkWidget *widget, const gchar *detail, gint x, gint y, gint width, gint height)
+{
+	cairo_t *cr = gtk3compat_cairo_create(window);
+	gint w, h;
+	gdk_drawable_get_size(window, &w, &h);
+	if(width < 0) width = w;
+	if(height < 0) height = h;
+	if(area) { gdk_cairo_rectangle(cr, area); cairo_clip(cr); }
+	G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+	gtk_paint_flat_box(style, cr, state, shadow, widget, detail, x, y, width, height);
+	G_GNUC_END_IGNORE_DEPRECATIONS
+	cairo_destroy(cr);
+}
+
+/* replacement for GtkHandleBox: a GtkBin giving its child the full allocation */
+GtkWidget *gtk3compat_handle_box_new(void)
+{
+	GtkWidget *box = gtk_event_box_new();
+	gtk_event_box_set_visible_window(GTK_EVENT_BOX(box), FALSE);
+	return box;
+}
diff --git a/src/Common/Gtk3Compat.h b/src/Common/Gtk3Compat.h
